#!/usr/bin/env bash
#MISE description="Amorce fnox et OpenCommit sur ce poste"
# Lancée par `mise bootstrap` à chaque exécution : chaque étape est idempotente.
set -euo pipefail

fnox_dir="$HOME/.config/fnox"
key_file="$fnox_dir/age.txt"
config_file="$fnox_dir/config.toml"

# Clé age du poste : générée une seule fois, jamais remplacée.
if [[ ! -f $key_file ]]; then
  install -d -m 700 "$fnox_dir"
  (umask 077 && age-keygen -o "$key_file")
fi

if [[ ! -f $config_file ]]; then
  cat >"$config_file" <<EOF
default_provider = "age"

[providers.age]
type = "age"
recipients = ["$(age-keygen -y "$key_file")"]
EOF
fi

# `fnox get` renvoie 0 pour un secret déclaré sans valeur : tester la sortie.
if [[ -z "$(fnox get OCO_API_KEY 2>/dev/null)" ]]; then
  if { : </dev/tty; } 2>/dev/null; then
    api_key=""
    while [[ -z $api_key ]]; do
      read -rsp "Clé API Anthropic pour OpenCommit : " api_key </dev/tty
      echo
    done
    # fnox 1.39 ignore stdin quand --description est passé : deux appels.
    printf '%s' "$api_key" | fnox set --global OCO_API_KEY --provider age
    fnox set --global OCO_API_KEY --description "Clé API Anthropic (OpenCommit)" </dev/null
  else
    echo "bootstrap: pas de terminal, OCO_API_KEY non configurée ; relancer \`mise bootstrap --only task\`" >&2
  fi
fi

# Les postinstall de node et rtk ne tournent qu'à l'installation :
# couvre les versions déjà présentes.
if [[ ! -x "$(npm prefix --global)/bin/oco" ]]; then
  npm install --global opencommit
fi
rtk init --global --auto-patch >/dev/null

# Hook prepare-commit-msg d'OpenCommit, copié par git dans chaque dépôt créé
# par `git init` ou `git clone`. Il vise node/latest pour suivre les montées
# de version de Node. core.hooksPath désactiverait les hooks propres à chaque
# dépôt (prek), d'où init.templateDir.
template_dir="$HOME/.config/git/template"
oco_cli="$(dirname "$(mise where node)")/latest/lib/node_modules/opencommit/out/cli.cjs"
current_template="$(git config --global --get init.templateDir || true)"
if [[ -z $current_template || $current_template == "$template_dir" ]]; then
  install -d "$template_dir/hooks"
  ln -sfn "$oco_cli" "$template_dir/hooks/prepare-commit-msg"
  git config --global init.templateDir "$template_dir"
else
  echo "bootstrap: init.templateDir vaut déjà $current_template ; hook OpenCommit non installé" >&2
fi
