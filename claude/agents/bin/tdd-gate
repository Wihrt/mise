#!/usr/bin/env python3
"""tdd-gate: verify the red and green gates of a stacked-TDD flow.

  tdd-gate red   --slug S --test SHA --task T [--repo DIR] [--spec PATH --ac ID,ID] [--allow-compile-red]
  tdd-gate green --slug S --test SHA --feat SHA --task T [--repo DIR] [--ac-changed ID,ID] [--replaces S,S]
  tdd-gate characterize --slug S --test SHA --task T --spec PATH --ac ID,ID --proofs|--mutants DIR [--repo DIR]
                        [--ac-changed ID,ID] [--replaces S,S]

`characterize` proves tests that are already green: per criterion it applies a mutant patch
(DIR/<ID>.patch, outside the repo), expects the test to fail (KILLED), and restores the tree.
`--replaces` lets the listed slugs' test files and TESTS.md sections be changed or removed (REPLACED lines).

Per-test results come from a report the test task writes: JUnit XML in
.tdd/junit.xml or the output of `tofu test -json-into=.tdd/tofu.json`
(detected after the run; --format forces one). Stale reports are deleted first.
Last output line is PASS or FAIL. Exit 0 PASS, 1 FAIL, 2 usage/environment error.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib
import xml.etree.ElementTree as ET
from fnmatch import fnmatch
from pathlib import Path

# An ID is letters, optional dash, 3+ digits, not followed by an alphanumeric
# (so TestSHA256Sum and TestHTTP2Handler are legacy names, not IDs).
WIRING_FILES = (".pre-commit-config.yaml", ".gitlab-ci.yml", ".github/workflows/*")
ID_RE = r"[A-Z]+-?[0-9]{3,}(?![A-Za-z0-9])"
NAME_POS = re.compile(r"^\s*(?:func Test|def test_?|- ?it:\s*\"?\[?|it:\s*\"?\[?|run \"|@test \")")
NAME_POS_SELECT = re.compile(r"^\s*(func Test|def test|- ?it:|it:|run \"|@test \")")
DEFAULT_REPORT = {"junit": ".tdd/junit.xml", "tofu-json": ".tdd/tofu.json"}


class GateError(Exception):
    """Usage or environment problem (exit 2)."""


def out(msg=""):
    print(msg, flush=True)


# ---------------------------------------------------------------- names / IDs
def norm(s):
    """Strip a leading Test / test_ / test, then every dash."""
    return re.sub(r"^(Test|test_|test)", "", s).replace("-", "")


def candidate(name):
    """Normalized ID at the very start of a (reported) test name, or None."""
    s = re.sub(r"^(Test|test_|test)", "", name)
    s = re.sub(r'^"?\[?', "", s)
    s = re.sub(r"^([A-Z]+)_(?=[0-9]{3})", r"\1", s)  # PREFIX_DIGITS
    m = re.match(ID_RE, s)
    return m.group(0).replace("-", "") if m else None


def section_ids(text, slug):
    ids, inside = [], False
    for line in text.splitlines():
        if line.startswith("## "):
            parts = line.split()
            inside = len(parts) > 1 and parts[1] == slug
        elif inside and line.startswith("### "):
            parts = line.split()
            if len(parts) > 1 and parts[1].rstrip(":") not in ids:
                ids.append(parts[1].rstrip(":"))
    return ids


CRITERIA_HEADINGS = ("Critères d'acceptation", "Acceptance criteria")


def spec_criteria(text):
    ids, inside = [], False
    for line in text.splitlines():
        if line.startswith("## "):
            inside = line[3:].strip() in CRITERIA_HEADINGS
        elif inside:
            m = re.match(r"### (" + ID_RE + ")", line)
            if m:
                ids.append(m.group(1))
    return ids


def all_ids(text):
    found = set()
    for line in text.splitlines():
        m = re.match(r"### (" + ID_RE + ")", line)
        if m:
            found.add(norm(m.group(1)))
    return found


def id_labels(text):
    """Map each normalized ID of TESTS.md (all sections) to its written form (CALC-001)."""
    labels = {}
    for line in text.splitlines():
        m = re.match(r"### (" + ID_RE + ")", line)
        if m:
            labels.setdefault(norm(m.group(1)), m.group(1))
    return labels


def out_of_scope(text, task, keep=()):
    """Map normalized ID -> Commande text for IDs whose section declares a Commande other than `mise run <task>`.

    IDs in `keep` (the slug's own, --ac) are always in scope."""
    result, command, pat = {}, None, re.compile(r"mise run " + re.escape(task) + r"(?![\w:.-])")
    for line in text.splitlines():
        if line.startswith("## "):
            command = None
        elif (m := re.search(r"Commande\s*:\s*(.*)$", line)) and not line.startswith("### "):
            command = m.group(1).strip()
        elif command is not None and not pat.search(command):
            m = re.match(r"### (" + ID_RE + ")", line)
            if m and norm(m.group(1)) not in keep:
                result.setdefault(norm(m.group(1)), command)
    return result


def report_out_of_scope(skipped, labels):
    for n in sorted(skipped):
        out(f"OUT OF SCOPE {labels[n]}: {skipped[n]}")


def incomplete_headings(text):
    res, h, s, t = [], None, False, False
    for line in text.splitlines():
        if line.startswith("### "):
            if h and (not s or not t):
                res.append(h)
            h, s, t = line, False, False
        if "**Spec**" in line or "**Critère**" in line:
            s = True
        if "**Test**" in line:
            t = True
    if h and (not s or not t):
        res.append(h)
    return res


def incomplete_entries(text, slug):
    res, inside, cur, seen = [], False, None, set()
    for line in text.splitlines() + ["## "]:
        if line.startswith("#"):
            if cur and len(seen) < 3:
                res.append(cur)
            cur, seen = None, set()
            if line.startswith("## "):
                inside = line.split()[1:2] == [slug]
            elif inside:
                cur = line.split()[1]
        else:
            seen |= {k for k in ("Étant donné", "Quand", "Alors") if f"**{k}**" in line}
    return res


def check_entries(text, slug):
    ids = incomplete_entries(text, slug)
    for i in ids:
        out(f"INCOMPLETE {i}: Étant donné/Quand/Alors manquant")
    return not ids


def test_files(text, repo):
    files = set()
    for line in text.splitlines():
        m = re.search(r"\*\*Test\*\*[^`]*`([^`]+)`", line)
        if m and (repo / m.group(1)).is_file():
            files.add(m.group(1))
    return sorted(files)


def section_test_files(text):
    res, slug = {}, None
    for line in text.splitlines():
        if line.startswith("## "):
            parts = line.split()
            slug = parts[1] if len(parts) > 1 else None
            continue
        m = re.search(r"\*\*Test\*\*[^`]*`([^`]+)`", line)
        if slug and m:
            res.setdefault(slug, set()).add(m.group(1))
    return res


class Entry:
    def __init__(self, file, line, cand, body):
        self.file, self.line, self.cand, self.body = file, line, cand, body


def scan_tests(repo, files, rev=None):
    """Test names at name positions only, in the work tree or at `rev`. Returns (entries, preambles)."""
    entries, pre = [], {}
    for f in files:
        lines = (git(repo, "show", f"{rev}:{f}")[1] if rev else (repo / f).read_text(errors="replace")).splitlines()
        idx = [i for i, ln in enumerate(lines) if NAME_POS_SELECT.match(ln)]
        pre[f] = "\n".join(lines[: idx[0]]) if idx else "\n".join(lines)
        for n, i in enumerate(idx):
            end = idx[n + 1] if n + 1 < len(idx) else len(lines)
            stripped = NAME_POS.sub("", lines[i], count=1)
            m = re.match(ID_RE, stripped)
            cand = m.group(0).replace("-", "") if m else None
            entries.append(Entry(f, i + 1, cand, "\n".join(lines[i:end]).rstrip()))
    return entries, pre


# -------------------------------------------------------------------- reports
class Report:
    """state: ok | missing | empty | unreadable. cases: [(name, pass|fail|skipped)]."""

    def __init__(self, state, cases=(), diag=""):
        self.state, self.cases, self.diag = state, list(cases), diag


def load_junit(path):
    if not path.is_file():
        return Report("missing")
    if path.stat().st_size == 0:
        return Report("empty")
    try:
        root = ET.parse(path).getroot()
    except ET.ParseError as e:
        return Report("unreadable", diag=str(e))
    cases = []
    for tc in root.iter("testcase"):
        tags = {c.tag for c in tc}
        status = "fail" if tags & {"failure", "error"} else "skipped" if "skipped" in tags else "pass"
        cases.append((tc.get("name", ""), status))
    return Report("ok" if cases else "empty", cases)


def load_tofu_json(path):
    if not path.is_file():
        return Report("missing")
    if path.stat().st_size == 0:
        return Report("empty")
    cases, diag, bad = [], [], False
    for raw in path.read_text(errors="replace").splitlines():
        try:
            ev = json.loads(raw)
        except json.JSONDecodeError:
            bad = True
            continue
        if ev.get("type") == "test_run":
            tr = ev["test_run"]
            st = tr.get("status")
            cases.append((tr.get("run", ""), "pass" if st == "pass" else "skipped" if st == "skip" else "fail"))
        elif ev.get("type") == "diagnostic":
            d = ev.get("diagnostic", {})
            diag.append(f"{d.get('summary', '')}: {d.get('detail', '')}")
    if bad and not cases:
        return Report("unreadable")
    return Report("ok" if cases else "empty", cases, "\n".join(diag))


def results_by_id(report):
    res = {}
    for name, status in report.cases:
        c = candidate(name)
        if c:
            res.setdefault(c, []).append((name, status))
    return res


# ------------------------------------------------------------ compile errors
SYMBOL_PATTERNS = [
    (re.compile(r"undefined: ([\w.]+)"), None),
    (re.compile(r"NameError: name '(\w+)' is not defined"), None),
    (re.compile(r"cannot import name '(\w+)'"), None),
    (re.compile(r"No module named '([\w.]+)'"), None),
    (re.compile(r"(?:Reference to undeclared[^:\n]*|Unsupported attribute)\W+.*?\"(\w+)\""), None),
]
ERROR_LINE = re.compile(
    r"undefined: |NameError|ImportError|ModuleNotFoundError|cannot import name|Reference to undeclared|Unsupported attribute"
)


def compile_errors(text):
    """[(line, [symbols])] for every line that looks like a compile/collect error."""
    res = []
    for line in text.splitlines():
        if not ERROR_LINE.search(line):
            continue
        syms = []
        for rx, _ in SYMBOL_PATTERNS:
            for m in rx.finditer(line):
                s = m.group(1)
                syms += [s, s.split(".")[-1]]
        res.append((line, sorted(set(syms))))
    return res


# ----------------------------------------------------------------- processes
def git(repo, *args):
    p = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, errors="replace")
    return p.returncode, p.stdout


def go_env():
    """Environment with -count=1 in GOFLAGS: go's test cache must not hide source changes."""
    env = dict(os.environ)
    flags = env.get("GOFLAGS", "").split()
    if "-count=1" not in flags:
        flags.append("-count=1")
    env["GOFLAGS"] = " ".join(flags)
    return env


def run_mise(repo, task, timeout):
    out(f"$ mise run {task}")
    try:
        p = subprocess.run(
            ["mise", "run", task], cwd=repo, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, errors="replace", timeout=timeout, env=go_env(),
        )
    except FileNotFoundError:
        raise GateError("mise not found in PATH")
    except subprocess.TimeoutExpired as e:
        txt = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
        out(txt)
        out(f"TIMEOUT after {timeout}s")
        return 124, txt
    out(p.stdout.rstrip("\n"))
    out(f"exit={p.returncode}")
    return p.returncode, p.stdout


def run_task_and_report(args, repo):
    def path(fmt):
        rp = Path(args.report or DEFAULT_REPORT[fmt])
        return rp if rp.is_absolute() else repo / rp

    formats = [args.format] if args.format else list(DEFAULT_REPORT)
    for fmt in formats:  # never trust a stale report
        path(fmt).parent.mkdir(parents=True, exist_ok=True)
        path(fmt).unlink(missing_ok=True)
    rc, output = run_mise(repo, args.task, args.timeout)
    fmt = next((f for f in formats if path(f).is_file()), formats[0])
    rp = path(fmt)
    loader = load_tofu_json if fmt == "tofu-json" else load_junit
    rep = loader(rp)
    if rep.state == "missing":
        out(f"REPORT missing: {args.task} n'a pas écrit {args.report or DEFAULT_REPORT[fmt]}")
    else:
        out(f"REPORT {rp}: {rep.state}, {len(rep.cases)} testcases")
    return rc, output, rep


def mise_non_tools(repo, sha):
    rc, txt = git(repo, "show", f"{sha}:mise.toml")
    if rc != 0:
        return []
    keep, t = [], False
    for line in txt.splitlines():
        if line.startswith("["):
            t = line != "[tools]"
        if t:
            keep.append(line)
    return keep


# --------------------------------------------------------------------- modes
def prepare(args):
    repo = Path(args.repo).resolve()
    tests_md = repo / "TESTS.md"
    if not tests_md.is_file():
        raise GateError(f"{tests_md} not found")
    rc, _ = git(repo, "rev-parse", "--git-dir")
    if rc != 0:
        raise GateError(f"{repo} is not a git repository")
    text = tests_md.read_text()
    ids = section_ids(text, args.slug)
    if not ids:
        out("NO IDS FOUND")
        raise GateError("no ids")
    out("IDS: " + " ".join(sorted(ids)))
    entries, pre = scan_tests(repo, test_files(text, repo))
    return repo, text, ids, entries, pre


def check_criteria(args, repo, ids, text):
    sp = Path(args.spec)
    sp = sp if sp.is_absolute() else repo / sp
    if not sp.is_file():
        raise GateError(f"{sp} not found")
    spec = sp.read_text()
    crit = spec_criteria(spec)
    out("CRITERIA: " + " ".join(crit))
    spec_n, ac_n, sec_n = ({norm(i) for i in x} for x in (crit, args.ac, ids))
    ok = True
    if git(repo, "status", "--short", "--", str(sp))[1].strip():
        out(f"SPEC NOT COMMITTED {args.spec}")
    for i in args.ac:
        if norm(i) not in spec_n:
            out(f"NOT IN SPEC {i}")
            ok = False
        if norm(i) not in sec_n:
            out(f"NOT IN SECTION {i}")
            ok = False
    for i in ids:
        if norm(i) not in ac_n:
            out(f"NOT IN --ac {i}")
            ok = False
        n, m = clause_count(entry_text(text, i)), clause_count(entry_text(spec, i))
        if n != m:
            out(f"CLAUSES {i}: {n} in TESTS.md, {m} in spec")
            ok = False
    return ok


def gate_red(args):
    repo, text, ids, entries, pre = prepare(args)
    ok = check_entries(text, args.slug)
    acceptance = bool(args.spec)
    if acceptance:
        ok = check_criteria(args, repo, ids, text) and ok
        if not check_acceptance_paths(repo, args.test):
            ok = False
    names = {e.cand for e in entries if e.cand}
    _, st = git(repo, "status", "--short")
    out("git status --short:\n" + st.rstrip("\n"))
    for i in ids:
        if norm(i) not in names:
            out(f"MISSING {i}")
            ok = False
    rc, output, rep = run_task_and_report(args, repo)
    if rc == 0:
        out("TASK PASSED, NOT RED")
        ok = False
    errs = compile_errors(output + "\n" + rep.diag)
    for line, _ in errs:
        out("COMPILE OR COLLECT ERROR: " + line.strip())
    res = results_by_id(rep)
    for i in ids:
        n = norm(i)
        cases = res.get(n, [])
        failed = [c for c in cases if c[1] == "fail"]
        if failed:
            out(f"RED {i}: {failed[0][0]}")
            continue
        if cases:
            out(f"NOT RED {i}: {cases[0][0]} {cases[0][1]}")
            ok = False
            continue
        hit = None
        for e in (e for e in entries if e.cand == n):
            for _, syms in errs:
                for s in syms:
                    rx = re.compile(r"\b" + re.escape(s) + r"\b")
                    if rx.search(e.body) or rx.search(pre[e.file]):
                        hit = (s, e)
                        break
                if hit:
                    break
            if hit:
                break
        if hit and acceptance and not args.allow_compile_red:
            out(f"NOT RED {i}: compile/collect error excuse refused in acceptance mode")
            ok = False
        elif hit:
            out(f"RED {i}: no result (report {rep.state}), excused by compile/collect error: "
                f"`{hit[0]}` used in {hit[1].file}:{hit[1].line}")
        else:
            out(f"NOT RED {i}: no result in report ({rep.state}) and no compile/collect error naming a symbol of its test")
            ok = False
    return ok


ACCEPTANCE_BASENAMES = {"TESTS.md", "mise.toml", ".gitignore", "conftest.py"}
ACCEPTANCE_DIRS = {"test", "tests", "acceptance", "testdata"}


def is_test_path(path):
    parts = path.split("/")
    base = parts[-1]
    return (
        base in ACCEPTANCE_BASENAMES
        or re.fullmatch(r".*_test\..*", base) is not None
        or re.fullmatch(r"test_.*\.py", base) is not None
        or base.endswith(".tftest.hcl")
        or any(d in ACCEPTANCE_DIRS for d in parts[:-1])
    )


def check_acceptance_paths(repo, sha):
    ok = True
    _, files = git(repo, "show", "--name-only", "--format=", sha)
    for f in files.split("\n"):
        if f and not is_test_path(f):
            out(f"NON-TEST FILE IN ACCEPTANCE COMMIT: {f}")
            ok = False
    return ok


def replaced_ids(before, after, slugs):
    """IDs of the given slugs' sections in `before` that are gone from `after`."""
    kept = all_ids(after)
    return {i for s in slugs for i in section_ids(before, s) if norm(i) not in kept}


def check_replaces(args, repo):
    """TESTS.md at <test>~1; every --replaces slug must have a section there (else GateError, exit 2)."""
    rc, before = git(repo, "show", f"{args.test}~1:TESTS.md")
    before = before if rc == 0 else ""
    for slug in args.replaces:
        if not section_ids(before, slug):
            raise GateError(f"--replaces {slug}: no such slug in TESTS.md at {args.test}~1")
    return before


def check_orphans(repo, text, before):
    """Files cited at <test>~1 but no longer by TESTS.md, still on disk: their tests with an ID absent from TESTS.md still run."""
    cited_now = set().union(*section_test_files(text).values())
    cited_before = set().union(*section_test_files(before).values())
    files = sorted(f for f in cited_before - cited_now if (repo / f).is_file())
    known, labels = all_ids(text), id_labels(before)
    ok = True
    for e in scan_tests(repo, files)[0]:
        if e.cand and e.cand not in known:
            out(f"ORPHAN TEST {e.file}:{e.line} {labels.get(e.cand, e.cand)}")
            ok = False
    return ok


def check_stability(args, repo, text, before=""):
    replaced = set(args.replaces)
    owners = {}  # earlier test file -> slugs (other than ours) citing it, now or at <test>~1
    for cited in (section_test_files(text), section_test_files(before)):
        for slug, files in cited.items():
            for f in files if slug != args.slug else ():
                owners.setdefault(f, set()).add(slug)
    rc, diff = git(repo, "diff", "--name-only", args.test + "~1", args.feat)
    changed = set(diff.split("\n")) - {""} if rc == 0 else set()
    allowed = {norm(i): i for i in args.ac_changed}
    ok = True
    for f in sorted(set(owners) & changed):
        if owners[f] <= replaced:
            for slug in sorted(owners[f]):
                out(f"REPLACED {slug}: {f}")
            continue
        entries, _ = scan_tests(repo, [f]) if (repo / f).is_file() else ([], {})
        hit = next((allowed[e.cand] for e in entries if e.cand in allowed), None)
        if hit:
            out(f"CRITERION CHANGE ALLOWED: {f} ({hit})")
        else:
            out(f"EARLIER ACCEPTANCE TEST MODIFIED: {f}")
            ok = False
    for slug in sorted(replaced):
        for i in sorted(replaced_ids(before, text, [slug])):
            out(f"REPLACED {slug}: {i}")
    kept = (all_ids(before) & all_ids(text)) - set(allowed)
    now = {}
    for e in scan_tests(repo, test_files(text, repo))[0]:
        now.setdefault(e.cand, []).append(e.body)
    cited = sorted(set().union(*section_test_files(before).values()))
    for e in scan_tests(repo, cited, args.test + "~1")[0]:
        if e.cand in kept and e.body not in now[e.cand]:
            out(f"KEPT TEST MODIFIED {e.file} {id_labels(before)[e.cand]}")
            ok = False
    return ok


def wired_tasks(repo, sha):
    """Tasks cited by `mise run` in a commit-hook or CI file of the commit, plus their direct `depends` in mise.toml."""
    _, names = git(repo, "ls-tree", "-r", "--name-only", sha)
    wired = set()
    for f in names.splitlines():
        if any(fnmatch(f, w) for w in WIRING_FILES):
            wired.update(re.findall(r"mise run\s+([\w:.-]+)", git(repo, "show", f"{sha}:{f}")[1]))
    tasks = tomllib.loads(git(repo, "show", f"{sha}:mise.toml")[1])["tasks"]
    for t in list(wired):
        wired.update(tasks.get(t, {}).get("depends", []))
    return wired


def check_wired(repo, sha, text, slug):
    section = re.search(r"^## " + re.escape(slug) + r"\b.*?(?=^## |\Z)", text, re.M | re.S)
    cmd = re.search(r"Commande\s*:\s*`mise run ([\w:.-]+)", section.group(0)) if section else None
    if cmd and cmd.group(1) not in wired_tasks(repo, sha):
        out(f"NOT WIRED {cmd.group(1)}")
        return False
    return True


def gate_green(args):
    repo, text, ids, entries, pre = prepare(args)
    before = check_replaces(args, repo)
    ok = check_entries(text, args.slug)
    ok = check_orphans(repo, text, before) and ok
    ok = check_wired(repo, args.feat, text, args.slug) and ok
    _, head = git(repo, "rev-parse", "HEAD")
    out(f"HEAD {head.strip()} (feat {args.feat})")
    _, tfiles = git(repo, "show", "--name-only", "--format=", args.test)
    _, changed = git(repo, "diff", "--name-only", args.test, args.feat)
    prot = set(tfiles.split("\n")) - {"mise.toml", ""}
    changed = set(changed.split("\n")) - {""}
    for f in sorted(prot & changed):
        out(f"PROTECTED FILE MODIFIED: {f}")
        ok = False
    if "TESTS.md" in changed and "TESTS.md" not in prot:
        out("PROTECTED FILE MODIFIED: TESTS.md")
        ok = False
    if mise_non_tools(repo, args.test) != mise_non_tools(repo, args.feat):
        out("PROTECTED FILE MODIFIED: mise.toml (tasks)")
        ok = False
    if not check_stability(args, repo, text, before):
        ok = False
    names = {e.cand for e in entries if e.cand}
    ids_all = all_ids(text)
    exempt = set(out_of_scope(text, args.task, {norm(i) for i in ids}))
    for i in sorted(ids_all - names - exempt):
        out(f"ID WITHOUT TEST: {i}")
        ok = False
    for i in sorted(names - ids_all):
        out(f"TEST WITHOUT ID: {i}")
        ok = False
    for h in incomplete_headings(text):
        out(f"INCOMPLETE: {h}")
        ok = False
    rc, output, rep = run_task_and_report(args, repo)
    res = results_by_id(rep)
    if rep.state != "ok":
        out(f"REPORT {rep.state}: no per-test result")
        ok = False
    for i in ids:
        cases = res.get(norm(i), [])
        if not cases:
            out(f"NO RESULT {i}")
            ok = False
            continue
        bad = [c for c in cases if c[1] != "pass"]
        if bad:
            out(f"NOT GREEN {i}: {bad[0][0]} {bad[0][1]}")
            ok = False
        else:
            out(f"GREEN {i}: {len(cases)} testcase(s)")
    own = {norm(i) for i in ids}
    labels = id_labels(text)
    skipped = out_of_scope(text, args.task, own)
    report_out_of_scope(skipped, labels)
    for n in sorted(ids_all - own - set(skipped)):
        i = labels[n]
        cases = res.get(n, [])
        if not cases:
            out(f"NO RESULT {i}")
            ok = False
            continue
        bad = [c for c in cases if c[1] != "pass"]
        if bad:
            out(f"REGRESSION {i}: {bad[0][0]} {bad[0][1]}")
            ok = False
    crc, _ = run_mise(repo, "check", args.timeout)
    if crc != 0:
        out("CHECK FAILED")
        ok = False
    if args.proofs:
        if not run_proofs(args, repo, text, ids):
            ok = False
        if not run_minimal(args, repo):
            ok = False
    elif not args.proof_exempt:
        out("PROOF MISSING: --proofs DIR or --proof-exempt")
        ok = False
    return ok


def apply_mutant(repo, patch):
    """Apply the patch to the working tree. Returns the files it creates."""
    _, summary = git(repo, "apply", "--summary", str(patch))
    created = re.findall(r"^ create mode \d+ (.+)$", summary, re.M)
    rc, _ = git(repo, "apply", str(patch))
    if rc != 0:
        raise GateError(f"git apply failed: {patch}")
    return created


def restore_tree(repo, created):
    git(repo, "checkout", "--", ".")
    if created:
        git(repo, "clean", "-fdq", "--", *created)
    for f in created:
        (repo / f).unlink(missing_ok=True)


def mise_problem(repo, patch, task):
    """Reason why the patch changes mise.toml outside the allowed tasks, or None."""
    table = None
    old = (repo / "mise.toml").read_text().splitlines()
    for line in patch.read_text().splitlines():
        if line.startswith("diff --git "):
            in_file = line.endswith(" b/mise.toml")
        elif not in_file:
            continue
        elif m := re.match(r"@@ -(\d+)", line):
            for prev in old[: int(m.group(1)) - 1]:
                table = table_of(prev, table)
        elif line[:1] in " +-":
            table = table_of(line[1:], table)
            if line[0] != " " and table == task:
                return f"touches test task {table}"
    return None


def table_of(line, table):
    """The table in force after this line of mise.toml: a task name, or None."""
    if line.startswith("["):
        m = re.fullmatch(r'\[tasks\.("?)(.+?)\1\]\s*', line)
        return m.group(2) if m else None
    return table


def mutant_problem(repo, patch, task):
    """Reason why the patch cannot be used as a mutant, or None."""
    rc, _ = git(repo, "apply", "--check", str(patch))
    if rc != 0:
        return "patch does not apply"
    _, numstat = git(repo, "apply", "--numstat", str(patch))
    for line in numstat.splitlines():
        f = line.split("\t", 2)[-1]
        if f != "mise.toml" and is_test_path(f):
            return f"touches test path {f}"
    return mise_problem(repo, patch, task)


def entry_text(text, i):
    lines, found = [], False
    for line in text.splitlines():
        if line.startswith("#"):
            found = line.startswith("### ") and line.split()[1] == i
        elif found:
            lines.append(line)
    return "\n".join(lines)


def clause_count(entry_text):
    """Number of clauses of the Alors: 1 for a one-line Alors, else the items of its sub-list."""
    lines = entry_text.splitlines()
    for n, line in enumerate(lines):
        if "**Alors**" in line:
            if line.split("**Alors**", 1)[1].strip():
                return 1
            indent = len(line) - len(line.lstrip())
            count = 0
            for sub in lines[n + 1:]:
                if len(sub) - len(sub.lstrip()) <= indent:
                    break
                count += sub.lstrip().startswith("- ")
            return count
    return 0


def run_patch(args, repo, patch, kind, tag, i):
    """Apply the patch, run the task, restore the tree. Returns (problem, results by criterion, tree status)."""
    problem = mutant_problem(repo, patch, args.task)
    if problem:
        return problem, {}, ""
    created = apply_mutant(repo, patch)
    try:
        out(f"{kind} {tag}: patch applied")
        rc, output, rep = run_task_and_report(args, repo)
        if rc == 124:
            raise GateError(f"{kind.lower()} {tag}: task timed out")
    finally:
        restore_tree(repo, created)
    _, st = git(repo, "status", "--short")
    return None, results_by_id(rep), st.strip()


def redundant(kills):
    """[(A, B)]: every mutant of A also fails a test of the other criterion B. kills: {A: [failed criteria per mutant]}."""
    return [(a, b) for a, per_mutant in kills.items() for b in sorted(set.intersection(*per_mutant) - {a})]


def run_proofs(args, repo, text, ids):
    """True when every proof holds, False when one fails, None when the tree is left dirty."""
    ok = True
    kills = {}
    proofs = Path(args.proofs).resolve()
    for i in ids:
        for clause in range(1, clause_count(entry_text(text, i)) + 1):
            patch = proofs / (f"{i}.patch" if clause == 1 else f"{i}.{clause}.patch")
            tag = f"{i} clause {clause}"
            if not patch.is_file():
                out(f"MUTANT MISSING {tag}")
                ok = False
                continue
            problem, res, st = run_patch(args, repo, patch, "MUTANT", tag, i)
            cases = res.get(norm(i), [])
            failed = [c for c in cases if c[1] == "fail"]
            if problem:
                out(f"MUTANT INVALID {tag}: {problem}")
                ok = False
            elif failed:
                out(f"KILLED {tag}: {failed[0][0]}")
                kills.setdefault(norm(i), []).append(
                    {n for n, c in res.items() if any(x[1] == "fail" for x in c)})
            elif cases:
                out(f"SURVIVED {tag}")
                ok = False
            else:
                out(f"MUTANT INVALID {tag}: no result")
                ok = False
            if st:
                out(f"TREE NOT CLEAN after {tag}:\n" + st)
                return None
        patch = proofs / f"{i}.neutral.patch"
        if not patch.is_file():
            out(f"NEUTRAL MISSING {i}")
            ok = False
            continue
        problem, res, st = run_patch(args, repo, patch, "NEUTRAL", i, i)
        cases = res.get(norm(i), [])
        failed = [c for c in cases if c[1] == "fail"]
        if problem or not cases:
            out(f"NEUTRAL INVALID {i}")
            ok = False
        elif failed:
            out(f"BRITTLE {i}: {failed[0][0]}")
            ok = False
        else:
            out(f"NEUTRAL OK {i}")
    labels = id_labels(text)
    for a, b in redundant(kills):
        out(f"REDUNDANT {labels[a]}: covered by {labels[b]}")
        ok = False
    return ok


def added_blocks(repo, test, feat):
    """[(file, first line, last line)] of the blocks the feat commit adds to production files."""
    _, diff = git(repo, "diff", "-U0", f"{test}..{feat}")
    blocks, path = [], None
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line[6:]
        elif path and not is_test_path(path) and (m := re.match(r"@@ -\S+ \+(\d+)(?:,(\d+))? @@", line)):
            start, count = int(m.group(1)), int(m.group(2) or 1)
            if count:
                blocks.append((path, start, start + count - 1))
    return blocks


def run_minimal(args, repo):
    """True when every added block is needed (or accepted): removing it alone makes the task fail."""
    ok = True
    for path, start, end in added_blocks(repo, args.test, args.feat):
        tag = f"{path}:{start}-{end}"
        lines = (repo / path).read_text().splitlines(keepends=True)
        (repo / path).write_text("".join(lines[: start - 1] + lines[end:]))
        rc, _, rep = run_task_and_report(args, repo)
        restore_tree(repo, [])
        if rc != 0 or rep.state != "ok":
            continue
        if tag in args.unneeded_ok:
            out(f"UNNEEDED ACCEPTED {tag}")
        else:
            out(f"UNNEEDED {tag}")
            ok = False
    return ok


def gate_characterize(args):
    repo, text, ids, entries, pre = prepare(args)
    before = check_replaces(args, repo)
    ok = check_entries(text, args.slug)
    ok = check_criteria(args, repo, ids, text) and ok
    if not check_orphans(repo, text, before):
        ok = False
    if not check_acceptance_paths(repo, args.test):
        ok = False
    if not check_wired(repo, args.test, text, args.slug):
        ok = False
    _, st = git(repo, "status", "--short")
    if st.strip():
        out("TREE NOT CLEAN:\n" + st.rstrip("\n"))
        return False
    _, head = git(repo, "rev-parse", "HEAD")
    _, test = git(repo, "rev-parse", "--verify", "-q", args.test + "^{commit}")
    if head.strip() != test.strip():
        out(f"HEAD IS NOT --test: {head.strip()} (test {args.test})")
        return False
    rc, output, rep = run_task_and_report(args, repo)
    if rc == 124:
        raise GateError("baseline run timed out")
    res = results_by_id(rep)
    labels = id_labels(text)
    green = True
    keep = {norm(i) for i in ids} | {norm(i) for i in args.ac}
    skipped = out_of_scope(text, args.task, keep)
    report_out_of_scope(skipped, labels)
    for n in sorted(all_ids(text) - set(skipped)):
        cases = res.get(n, [])
        bad = [c for c in cases if c[1] != "pass"]
        if not cases:
            out(f"BASELINE NOT GREEN {labels[n]}: no result ({rep.state})")
            green = False
        elif bad:
            out(f"BASELINE NOT GREEN {labels[n]}: {bad[0][0]} {bad[0][1]}")
            green = False
    if not green:
        return False
    proved = run_proofs(args, repo, text, args.ac)
    if proved is None:
        return False
    ok = ok and proved
    args.feat = args.test  # nothing is committed: stability covers the acceptance commit
    if not check_stability(args, repo, text, before):
        ok = False
    return ok


def killed(args, repo, sha, patch):
    """Apply the patch on a throwaway worktree of sha and run the tasks: True when a task fails."""
    with tempfile.TemporaryDirectory(prefix="tdd-replay-") as tmp:
        wt = Path(tmp) / "wt"
        try:
            git(repo, "worktree", "add", "--detach", str(wt), sha)
            apply_mutant(wt, patch)
            return run_mise(wt, args.task, args.timeout)[0] != 0
        finally:
            git(repo, "worktree", "remove", "--force", str(wt))


def gate_replay(args):
    repo = Path(args.repo).resolve()
    ok = True
    for patch in sorted(Path(args.proofs).glob("*.patch")):
        name = patch.stem
        was, now = killed(args, repo, args.base, patch), killed(args, repo, args.head, patch)
        if was and now:
            out(f"KEPT {name}")
        elif not was and not now:
            out(f"NEVER {name}")
        elif now:
            out(f"GAINED {name}")
        elif name == args.accept_lost:
            out(f"LOST ACCEPTED {name}")
        else:
            out(f"LOST {name}")
            ok = False
    return ok


def build_parser():
    ap = argparse.ArgumentParser(prog="tdd-gate", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="mode", required=True)
    p = sub.add_parser("replay")
    p.add_argument("--repo", default=".")
    p.add_argument("--base", required=True, metavar="SHA")
    p.add_argument("--head", required=True, metavar="SHA")
    p.add_argument("--proofs", required=True, metavar="DIR")
    p.add_argument("--task", required=True, help="mise task")
    p.add_argument("--accept-lost", metavar="NAME")
    p.add_argument("--timeout", type=int, default=540)
    for mode in ("red", "green", "characterize"):
        p = sub.add_parser(mode)
        p.add_argument("--slug", required=True)
        p.add_argument("--test", required=True, metavar="SHA")
        if mode == "red":
            p.add_argument("--spec", help="spec file (absolute or repo-relative): acceptance mode")
            p.add_argument("--ac", type=lambda v: [x for x in v.split(",") if x], help="comma list of criteria IDs (needs --spec)")
            p.add_argument("--allow-compile-red", action="store_true", help="in acceptance mode, keep the compile/collect error excuse")
        if mode == "characterize":
            p.add_argument("--spec", required=True, help="spec file (absolute or repo-relative)")
            p.add_argument("--ac", required=True, type=lambda v: [x for x in v.split(",") if x], help="comma list of criteria IDs")
            g = p.add_mutually_exclusive_group(required=True)
            g.add_argument("--proofs", metavar="DIR", help="directory holding <ID>.patch, one per criterion")
            g.add_argument("--mutants", dest="proofs", metavar="DIR", help="synonym of --proofs")
        if mode in ("green", "characterize"):
            p.add_argument("--ac-changed", type=lambda v: [x for x in v.split(",") if x], default=[], help="comma list of criteria IDs whose test files may change")
            p.add_argument("--replaces", type=lambda v: [x for x in v.split(",") if x], default=[], help="comma list of slugs whose test files and TESTS.md sections may be changed or removed")
        if mode == "green":
            p.add_argument("--proofs", metavar="DIR", help="directory of proofs, run on the feat commit")
            p.add_argument("--unneeded-ok", action="append", default=[], metavar="FILE:START-END", help="added block accepted although no test needs it (repeatable)")
            p.add_argument("--proof-exempt", action="store_true", help="exempt from proofs")
            p.add_argument("--feat", required=True, metavar="SHA")
        p.add_argument("--task", required=True)
        p.add_argument("--repo", default=".")
        p.add_argument("--format", choices=sorted(DEFAULT_REPORT), help="report format (default: whichever of .tdd/junit.xml, .tdd/tofu.json the task wrote)")
        p.add_argument("--report", help="report path, repo-relative (needs --format when set)")
        p.add_argument("--timeout", type=int, default=540, help="seconds per mise run (default 540, below the 600 s Bash tool cap)")
    return ap


def main(argv=None):
    ap = build_parser()
    args = ap.parse_args(argv)  # usage errors exit 2
    if args.mode == "red" and bool(args.spec) != bool(args.ac):
        ap.error("--spec and --ac go together")
    try:
        ok = {"red": gate_red, "green": gate_green, "characterize": gate_characterize, "replay": gate_replay}[args.mode](args)
    except GateError as e:
        if str(e) != "no ids":
            out(f"ERROR: {e}")
        out("FAIL")
        return 2
    out("PASS" if ok else "FAIL")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
